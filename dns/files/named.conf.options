options {
    directory "/var/cache/bind";

    recursion yes;

    allow-query {
        localhost;
        192.168.57.0/24;
    };

    allow-recursion {
        localhost;
        192.168.57.0/24;
    };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };

    dnssec-validation auto;

    listen-on {
        127.0.0.1;
        192.168.57.5;
    };

    listen-on-v6 {
        none;
    };
};